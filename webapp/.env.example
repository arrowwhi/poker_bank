# Базовый URL Go-бэкенда. Пусто — используется in-memory мок API.
VITE_API_URL=
# Принудительно включить мок даже при заданном VITE_API_URL (1/0).
VITE_USE_MOCK=
# Username бота (без @) и short name Mini App — для ссылок «Добавить в группу» и «Скопировать ссылку на игру».
VITE_BOT_USERNAME=
VITE_APP_SHORT_NAME=
