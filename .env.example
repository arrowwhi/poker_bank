TELEGRAM_TOKEN=your_bot_token_here
DATABASE_URL=postgres://poker:poker@localhost:5432/poker_bank?sslmode=disable
LOG_LEVEL=info

GOOGLE_SHEETS_SPREADSHEET_ID=1-RNpJFiotgRGAJ9At6T8tDjbRGQBnlsj6fuCFA8-B7k
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/secrets/google-sa.json

# Режим получения обновлений: polling (локально) или webhook (прод).
TELEGRAM_MODE=polling
# Для webhook: внешний HTTPS-адрес сервиса и секрет заголовка Telegram.
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
# Публичный порт (API, Mini App, webhook) и служебный (/metrics, /ready).
HTTP_PORT=8080
ADMIN_PORT=9090
APP_ENV=local

# Short name Mini App из BotFather (/newapp): бот ставит под сообщениями кнопки-ссылки
# t.me/<bot>/<short_name>. По умолчанию poker_bank.
WEBAPP_SHORT_NAME=

# Сборка фронтенда (build args Dockerfile; в Coolify — Build Variables).
# Username бота без @ и short name Mini App: ссылки «Добавить бота в группу» и «Ссылка на игру».
VITE_BOT_USERNAME=
VITE_APP_SHORT_NAME=
